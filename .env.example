# Copy to .env.local and fill the key from `supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only needed to refresh catalog photographs from Unsplash.
# Create a free app at https://unsplash.com/developers and paste its Access Key.
UNSPLASH_ACCESS_KEY=
