{
  "$comment": [
    "Shared pricing fixtures. Executed by BOTH tests/unit/pricing.test.ts and",
    "supabase/tests/0005_pricing.sql. If one suite passes and the other fails,",
    "the two implementations of the pricing rule have drifted — which is exactly",
    "what this file exists to catch. Adding a pricing rule means adding a case",
    "here first.",
    "",
    "Fixture ids match supabase/seed.sql. Prices are the seeded ones, repriced",
    "by feature 007 to start at AED 5:",
    "  snake-desk        40000000-0000-4000-8000-000000000101  AED   6  stock 24",
    "  snake-floor       40000000-0000-4000-8000-000000000102  AED  16  stock 10",
    "  zz-desk           40000000-0000-4000-8000-000000000103  AED   7  stock 18",
    "  pothos-desk       40000000-0000-4000-8000-000000000105  AED   5  stock 30",
    "  aglaonema-floor   40000000-0000-4000-8000-000000000107  AED  18  stock  6",
    "  kentia-statement  40000000-0000-4000-8000-000000000108  AED  35  stock  5",
    "  areca-statement   40000000-0000-4000-8000-000000000109  AED  32  stock  0  (published, out of stock)",
    "  areca-floor-draft 40000000-0000-4000-8000-000000000110  unpublished draft",
    "Terms:    3mo x1.15, 6mo x1.07, 12mo x1.00 (default)",
    "Cadences: weekly AED 250, fortnightly AED 150 (default)"
  ],
  "terms": {
    "3": {
      "months": 3,
      "multiplier": 1.15
    },
    "6": {
      "months": 6,
      "multiplier": 1.07
    },
    "12": {
      "months": 12,
      "multiplier": 1
    }
  },
  "cadences": {
    "weekly": {
      "monthly_fee_aed": 250
    },
    "fortnightly": {
      "monthly_fee_aed": 150
    }
  },
  "cases": [
    {
      "name": "empty basket costs nothing, not a bare service fee",
      "items": [],
      "term_months": 12,
      "cadence_code": "fortnightly",
      "expect": {
        "plants_subtotal_aed": 0,
        "service_fee_aed": 0,
        "monthly_total_aed": 0,
        "has_unavailable_lines": false
      }
    },
    {
      "name": "single desk plant at the default term and cadence",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 1
        }
      ],
      "term_months": 12,
      "cadence_code": "fortnightly",
      "expect": {
        "plants_subtotal_aed": 6,
        "service_fee_aed": 150,
        "subtotal_aed": 156,
        "monthly_total_aed": 156,
        "has_unavailable_lines": false
      }
    },
    {
      "name": "quantities multiply and lines sum",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 4
        },
        {
          "variant": "40000000-0000-4000-8000-000000000103",
          "quantity": 3
        }
      ],
      "term_months": 12,
      "cadence_code": "fortnightly",
      "expect": {
        "plants_subtotal_aed": 45,
        "service_fee_aed": 150,
        "subtotal_aed": 195,
        "monthly_total_aed": 195
      }
    },
    {
      "name": "weekly cadence raises the fee and leaves plant prices alone",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 4
        }
      ],
      "term_months": 12,
      "cadence_code": "weekly",
      "expect": {
        "plants_subtotal_aed": 24,
        "service_fee_aed": 250,
        "monthly_total_aed": 274
      }
    },
    {
      "name": "three-month term applies a 1.15 multiplier to the whole subtotal",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 4
        }
      ],
      "term_months": 3,
      "cadence_code": "fortnightly",
      "expect": {
        "plants_subtotal_aed": 24,
        "service_fee_aed": 150,
        "subtotal_aed": 174,
        "monthly_total_aed": 200.1,
        "cheapest_monthly_total_aed": 174,
        "flexibility_cost_aed": 26.1
      }
    },
    {
      "name": "six-month multiplier rounds to the fil once, not per line",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 3
        },
        {
          "variant": "40000000-0000-4000-8000-000000000108",
          "quantity": 1
        }
      ],
      "term_months": 6,
      "cadence_code": "weekly",
      "expect": {
        "plants_subtotal_aed": 53,
        "service_fee_aed": 250,
        "subtotal_aed": 303,
        "monthly_total_aed": 324.21,
        "flexibility_cost_aed": 21.21
      }
    },
    {
      "name": "an out-of-stock but published plant is unavailable and excluded",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 2
        },
        {
          "variant": "40000000-0000-4000-8000-000000000109",
          "quantity": 1
        }
      ],
      "term_months": 12,
      "cadence_code": "fortnightly",
      "expect": {
        "plants_subtotal_aed": 12,
        "service_fee_aed": 150,
        "monthly_total_aed": 162,
        "has_unavailable_lines": true,
        "line_statuses": {
          "40000000-0000-4000-8000-000000000109": "unavailable"
        }
      }
    },
    {
      "name": "an unpublished draft is unavailable even though it exists",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 1
        },
        {
          "variant": "40000000-0000-4000-8000-000000000110",
          "quantity": 5
        }
      ],
      "term_months": 12,
      "cadence_code": "fortnightly",
      "expect": {
        "plants_subtotal_aed": 6,
        "monthly_total_aed": 156,
        "has_unavailable_lines": true,
        "line_statuses": {
          "40000000-0000-4000-8000-000000000110": "unavailable"
        }
      }
    },
    {
      "name": "a quantity beyond stock is capped and the request is reported",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000108",
          "quantity": 9
        }
      ],
      "term_months": 12,
      "cadence_code": "fortnightly",
      "expect": {
        "plants_subtotal_aed": 175,
        "monthly_total_aed": 325,
        "line_statuses": {
          "40000000-0000-4000-8000-000000000108": "capped"
        },
        "line_quantities": {
          "40000000-0000-4000-8000-000000000108": 5
        },
        "line_requested": {
          "40000000-0000-4000-8000-000000000108": 9
        }
      }
    },
    {
      "name": "a basket of only unavailable lines totals zero, with no bare fee",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000109",
          "quantity": 3
        }
      ],
      "term_months": 3,
      "cadence_code": "weekly",
      "expect": {
        "plants_subtotal_aed": 0,
        "service_fee_aed": 0,
        "monthly_total_aed": 0,
        "has_unavailable_lines": true
      }
    },
    {
      "name": "an unknown variant id is unavailable rather than an error",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 1
        },
        {
          "variant": "40000000-0000-4000-8000-0000000009ff",
          "quantity": 2
        }
      ],
      "term_months": 12,
      "cadence_code": "fortnightly",
      "expect": {
        "plants_subtotal_aed": 6,
        "monthly_total_aed": 156,
        "has_unavailable_lines": true
      }
    },
    {
      "name": "a realistic small office at the shortest term",
      "items": [
        {
          "variant": "40000000-0000-4000-8000-000000000101",
          "quantity": 6
        },
        {
          "variant": "40000000-0000-4000-8000-000000000103",
          "quantity": 4
        },
        {
          "variant": "40000000-0000-4000-8000-000000000102",
          "quantity": 3
        },
        {
          "variant": "40000000-0000-4000-8000-000000000107",
          "quantity": 2
        },
        {
          "variant": "40000000-0000-4000-8000-000000000108",
          "quantity": 1
        }
      ],
      "term_months": 3,
      "cadence_code": "weekly",
      "expect": {
        "plants_subtotal_aed": 183,
        "service_fee_aed": 250,
        "subtotal_aed": 433,
        "monthly_total_aed": 497.95,
        "cheapest_monthly_total_aed": 433,
        "flexibility_cost_aed": 64.95
      }
    }
  ]
}
